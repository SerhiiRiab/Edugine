{
  "name": "Edugine Development",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  // Best-effort: exposes CLAUDE_CODE_OAUTH_TOKEN to VS Code/code-server itself.
  // Only takes effect after a full "Rebuild Container". The reliable path for
  // shells is the /etc/profile.d script written by postStartCommand below.
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
  },

  // Switch the default Node to 22 (required by @anthropic-ai/claude-code, see
  // its package.json engines field) and install Claude Code globally so it's
  // present and picks up CLAUDE_CODE_OAUTH_TOKEN automatically on every start.
  "postCreateCommand": "bash -lc 'source /home/codespace/nvm/nvm.sh && nvm alias default 22 && npm install -g @anthropic-ai/claude-code'",

  // remoteEnv alone is unreliable here: it only reaches shells VS Code spawns
  // after a full rebuild, and Claude Code's own process doesn't always see it
  // (it re-execs itself for the TUI). Writing it to /etc/profile.d instead
  // makes every login shell pick it up on each container start, no rebuild
  // needed. Also unset ANTHROPIC_API_KEY to prevent conflict with Claude Pro
  // OAuth authentication.
  "postStartCommand": "bash -lc 'printf \"export CLAUDE_CODE_OAUTH_TOKEN=%q\\n\" \"$CLAUDE_CODE_OAUTH_TOKEN\" | sudo tee /etc/profile.d/claude-code-oauth.sh > /dev/null && sudo chmod 644 /etc/profile.d/claude-code-oauth.sh && ( grep -qxF \"unset ANTHROPIC_API_KEY\" ~/.bashrc || echo \"unset ANTHROPIC_API_KEY\" >> ~/.bashrc ) && unset ANTHROPIC_API_KEY'",

  // Optional: Configure shell to use bash
  "customizations": {
    "codespaces": {
      "openFiles": []
    }
  }
}
