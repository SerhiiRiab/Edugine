# Supabase project URL — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co

# Supabase anon/public key — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Canonical public URL of the app (no trailing slash).
# Required in environments where window.location.origin includes a port
# that differs from the public URL (e.g. GitHub Codespaces, Gitpod).
# Must match the Site URL set in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=https://<your-public-host>

# Liveblocks secret key — found in the Liveblocks dashboard under API keys.
# Server-side only (used by /api/liveblocks-auth); never expose to the client.
LIVEBLOCKS_SECRET_KEY=<your-liveblocks-secret-key>

# Sanity CMS — project ID and dataset are public identifiers (safe to expose).
NEXT_PUBLIC_SANITY_PROJECT_ID=w605gzx1
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API read token — only needed if the dataset is private or you want
# to preview unpublished drafts. Found in sanity.io/manage → API → Tokens.
# Leave unset to fetch published content from the public dataset.
SANITY_API_READ_TOKEN=<optional-sanity-read-token>
